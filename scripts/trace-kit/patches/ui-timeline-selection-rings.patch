+/** Adjacent phases of one item share an outline, while gaps, rows, and interaction states stay separate. */
+function addMark(mark: ItemMark) {
+  for (let index = marks.length - 1; index >= 0; index--) {
+    const previous = marks[index]!
+    if (previous.key !== mark.key || previous.kind !== mark.kind || previous.top !== mark.top || previous.height !== mark.height || previous.radius !== mark.radius || previous.x1 < mark.x0 || previous.x0 > mark.x1)
+      continue
+    mark.x0 = Math.min(mark.x0, previous.x0)
+    mark.x1 = Math.max(mark.x1, previous.x1)
+    marks.splice(index, 1)
+  }
+  marks.push(mark)
