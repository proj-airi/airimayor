[
  {
    "type": "definition",
    "kind": "profile",
    "key": "agent",
    "data": {
      "key": "agent",
      "version": "1",
      "label": {
        "en": "Agent",
        "zh-Hans": "智能体"
      },
      "description": {
        "en": "Chat turns, model requests, tools, sub-agents, and async work such as memory decisions.",
        "zh-Hans": "聊天轮次、模型请求、工具、子智能体，以及记忆决策这类异步工作。"
      }
    }
  },
  {
    "type": "definition",
    "kind": "track",
    "key": "agents/{agent}/state",
    "data": {
      "path": "agents/{agent}/state",
      "entity": "agent",
      "group": "agents",
      "order": 0,
      "render": [
        "state"
      ],
      "states": [
        "running",
        "paused",
        "waiting",
        "done"
      ],
      "label": {
        "en": "State",
        "zh-Hans": "状态"
      }
    }
  },
  {
    "type": "definition",
    "kind": "track",
    "key": "agents/{agent}/turn",
    "data": {
      "path": "agents/{agent}/turn",
      "entity": "agent",
      "activity": "waiting",
      "group": "agents",
      "order": 10,
      "render": [
        "spans"
      ],
      "color": "#64748b",
      "icon": "i-mingcute:chat-2-line",
      "label": {
        "en": "Chat turn",
        "zh-Hans": "聊天轮次"
      }
    }
  },
  {
    "type": "definition",
    "kind": "track",
    "key": "agents/{agent}/llm",
    "data": {
      "path": "agents/{agent}/llm",
      "entity": "agent",
      "activity": "thinking",
      "activitySplit": {
        "instant": "llm.first_chunk",
        "activity": "active"
      },
      "group": "agents",
      "order": 20,
      "render": [
        "spans",
        "instants"
      ],
      "color": "#a855f7",
      "icon": "i-mingcute:ai-line",
      "label": {
        "en": "Model",
        "zh-Hans": "模型"
      }
    }
  },
  {
    "type": "definition",
    "kind": "track",
    "key": "agents/{agent}/tools",
