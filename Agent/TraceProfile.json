      "itemLabel": "name",
      "group": "agents",
      "order": 30,
      "render": [
        "spans"
      ],
      "color": "#0ea5e9",
      "icon": "i-mingcute:tool-line",
      "label": {
        "en": "Tools",
        "zh-Hans": "工具"
      }
    }
  },
  {
    "type": "definition",
