<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>airimayor.HotReload</AssemblyName>
    <RootNamespace>CS2MCP</RootNamespace>
    <Configurations>Debug;Release</Configurations>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" />

  <ItemGroup>
    <Compile Include="..\CS2MCP\RequestHandlers*.cs" Link="CS2MCP\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="airimayor">
      <!-- Compile against the deployed host with its merged dependencies. -->
      <HintPath>$(LocalModsPath)\airimayor\airimayor.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Game"><Private>false</Private></Reference>
    <Reference Include="Colossal.Core"><Private>false</Private></Reference>
    <Reference Include="Colossal.Logging"><Private>false</Private></Reference>
    <Reference Include="Colossal.IO.AssetDatabase"><Private>false</Private></Reference>
    <Reference Include="Colossal.Collections"><Private>false</Private></Reference>
    <Reference Include="Colossal.Mathematics"><Private>false</Private></Reference>
    <Reference Include="Colossal.UI"><Private>false</Private></Reference>
    <Reference Include="Colossal.Localization"><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><Private>false</Private></Reference>
    <Reference Include="Unity.Collections"><Private>false</Private></Reference>
    <Reference Include="Unity.Entities"><Private>false</Private></Reference>
    <Reference Include="Unity.Mathematics"><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="DeployHotReloadPayload" AfterTargets="Build">
    <PropertyGroup>
      <HotReloadDir>$(UserDataPath)\ModsData\airimayor\hot-reload</HotReloadDir>
      <!-- CS2 recursively discovers .dll files under the user-data tree as code
           mods. The host loads this payload explicitly from bytes, so keep a
           non-.dll extension to prevent a second, unintended mod load at boot. -->
      <HotReloadHandlersPayload>$(HotReloadDir)\RequestHandlers.payload</HotReloadHandlersPayload>
    </PropertyGroup>
    <MakeDir Directories="$(HotReloadDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(HotReloadHandlersPayload)" />
    <Copy SourceFiles="..\Host\ToolCatalog.json" DestinationFiles="$(HotReloadDir)\ToolCatalog.json" />
    <Message Text="Hot-reload payload deployed to $(HotReloadDir)" Importance="high" />
  </Target>

</Project>
