<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Configurations>Debug;Release</Configurations>
		<NoWarn>$(NoWarn);OPENAI001</NoWarn>
	
		<!--The file where mod information which is required for publishing mod on PDX mods are stored-->
		<PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>airimayor.HotReload</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
	
	<!--Imports must be after PropertyGroup block-->
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" />
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" />

	<ItemGroup>
		<Reference Include="Game">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Core">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Logging">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.IO.AssetDatabase">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Collections">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Mathematics">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.UI">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.UI.Binding">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Localization">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.InputSystem">
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine">
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.ScreenCaptureModule">
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.ImageConversionModule">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Burst">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Collections">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Entities">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Mathematics">
			<Private>false</Private>
		</Reference>
		<Reference Include="System.Net.Http">
			<Private>false</Private>
		</Reference>
		<Reference Include="Newtonsoft.Json">
			<HintPath>$(ManagedFullPath)\Newtonsoft.Json.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Reference Update="System">
			<Private>false</Private>
		</Reference>
		<Reference Update="System.Core">
			<Private>false</Private>
		</Reference>
		<Reference Update="System.Data">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="dotacp.client" Version="2026.7.19" />
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AgentRuntime\AgentRuntime.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Host\ToolCatalog.json" />
		<!-- The nested hot-reload payload has its own SDK project and obj tree;
		     do not let this project's default Compile glob ingest its generated
		     assembly-attribute sources. -->
		<Compile Remove="HotReload\**\*.cs" />
		<Compile Remove="Stubs\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
		<None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
	</ItemGroup>

	<Target Name="PublishCityToolsMcp" AfterTargets="DeployWIP" Condition="'$(NeedBuild)' == 'true' and '$(DeployDir)' != ''">
		<Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\Mcp\airimayor.Mcp.csproj&quot; -c $(Configuration) -o &quot;$(DeployDir)\mcp&quot;" />
	</Target>

	<!-- Official ModPostProcessor requires a full Unity Editor install + ScriptAssemblies.
	     This mod has no Burst jobs; skip so local builds work without Unity. -->
	<Target Name="RunModPostProcessor" />

	<!-- UI webpack writes into $(CSII_USERDATAPATH)\Mods\$(mod.json id); run after DeployWIP so it is not wiped. -->
	<Target Name="BuildUI" AfterTargets="DeployWIP" Condition="'$(NeedBuild)' == 'true'">
		<Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\UI" />
	</Target>

	<!-- Merge all managed dependencies into the single mod dll. The game's
	mod manager scans every dll in the mod folder during registration and can
	crash when the folder carries many dependency assemblies, so the shipped
	folder must stay lean. -->
	<Target Name="MergeDependencies" AfterTargets="DeployWIP" Condition="'$(NeedBuild)' == 'true'">
		<Exec Command="pwsh.exe -NoLogo -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\merge-deps.ps1&quot; -DeployDir &quot;$(DeployDir)&quot; -GameManaged &quot;$(ManagedFullPath)&quot;" LogStandardErrorAsError="true" />
	</Target>

	<!-- Overlay exists only while iterating with Mod/HotReload. A leftover
	     file would silently replace the catalog just embedded in this DLL. -->
	<Target Name="ClearHotReloadCatalog" AfterTargets="DeployWIP" Condition="'$(NeedBuild)' == 'true'">
		<Delete Files="$(UserDataPath)\ModsData\airimayor\hot-reload\ToolCatalog.json" />
	</Target>

</Project>
