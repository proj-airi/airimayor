<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GameManagedPath>$([System.Environment]::GetEnvironmentVariable('CSII_MANAGEDPATH', 'EnvironmentVariableTarget.User'))</GameManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="dotacp.client" Version="2026.7.19" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Mod\CS2MCP\OsmDocument*.cs" LinkBase="Production" />
    <Compile Include="..\Mod\CS2MCP\CityOsm*.cs" LinkBase="Production" />
    <Compile Include="..\Mod\CS2MCP\OsmRoadUpgrades.cs" Link="Production\OsmRoadUpgrades.cs" />
    <None Include="..\docs\research\examples\2026-11-21-osm\*.osm;..\docs\research\examples\2026-11-21-osm\*.osc" Link="OsmFixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\Mod\CS2MCP\NetworkCourseMath.cs" Link="Production\NetworkCourseMath.cs" />
    <Compile Include="..\Mod\CS2MCP\OperationalAreaPlanningMath.cs" Link="Production\OperationalAreaPlanningMath.cs" />
    <Compile Include="..\Mod\CS2MCP\PrefabOperationalAreaGraph.cs" Link="Production\PrefabOperationalAreaGraph.cs" />
    <Compile Include="..\Mod\CS2MCP\RoadFactsMath.cs" Link="Production\RoadFactsMath.cs" />
    <Compile Include="..\Mod\CS2MCP\TypedNetworkMath.cs" Link="Production\TypedNetworkMath.cs" />
    <Compile Include="..\Mod\CS2MCP\SimWait.cs" Link="Production\SimWait.cs" />
    <Compile Include="..\Mod\Host\PointedPlaceText.cs" Link="Production\PointedPlaceText.cs" />
    <Compile Include="..\Mod\Host\AcpSession.cs" Link="Production\AcpSession.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agent\airimayor.Agent.csproj" />
    <Reference Include="Colossal.Mathematics" HintPath="$(GameManagedPath)\Colossal.Mathematics.dll" />
    <Reference Include="Game" HintPath="$(GameManagedPath)\Game.dll" />
    <Reference Include="Unity.Entities" HintPath="$(GameManagedPath)\Unity.Entities.dll" />
    <Reference Include="Unity.Mathematics" HintPath="$(GameManagedPath)\Unity.Mathematics.dll" />
  </ItemGroup>

</Project>
