<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GameManagedPath>$([System.Environment]::GetEnvironmentVariable('CSII_MANAGEDPATH', 'EnvironmentVariableTarget.User'))</GameManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Mod\CS2MCP\MapRgb.cs" Link="Production\MapRgb.cs" />
    <Compile Include="..\Mod\CS2MCP\MapImageModel.cs" Link="Production\MapImageModel.cs" />
    <Compile Include="..\Mod\CS2MCP\MapStrokeRaster.cs" Link="Production\MapStrokeRaster.cs" />
    <Compile Include="..\Mod\CS2MCP\TrackStrokePaint.cs" Link="Production\TrackStrokePaint.cs" />
    <Compile Include="..\Mod\CS2MCP\MapImagePaint.cs" Link="Production\MapImagePaint.cs" />
    <Compile Include="..\Mod\CS2MCP\MapStrokeJoin.cs" Link="Production\MapStrokeJoin.cs" />
    <Compile Include="..\Mod\CS2MCP\NetworkBuildArguments.cs" Link="Production\NetworkBuildArguments.cs" />
    <Compile Include="..\Mod\CS2MCP\NetworkCourseMath.cs" Link="Production\NetworkCourseMath.cs" />
    <Compile Include="..\Mod\CS2MCP\OperationalAreaPlanningMath.cs" Link="Production\OperationalAreaPlanningMath.cs" />
    <Compile Include="..\Mod\CS2MCP\PlacementObstaclePolicy.cs" Link="Production\PlacementObstaclePolicy.cs" />
    <Compile Include="..\Mod\CS2MCP\PlacementSearchMath.cs" Link="Production\PlacementSearchMath.cs" />
    <Compile Include="..\Mod\CS2MCP\PrefabOperationalAreaGraph.cs" Link="Production\PrefabOperationalAreaGraph.cs" />
    <Compile Include="..\Mod\CS2MCP\RoadFactsMath.cs" Link="Production\RoadFactsMath.cs" />
    <Compile Include="..\Mod\CS2MCP\RoadGroundPreflight.cs" Link="Production\RoadGroundPreflight.cs" />
    <Compile Include="..\Mod\CS2MCP\TypedNetworkMath.cs" Link="Production\TypedNetworkMath.cs" />
    <Compile Include="..\Mod\CS2MCP\SimWait.cs" Link="Production\SimWait.cs" />
    <Compile Include="..\Mod\Host\PointedPlaceText.cs" Link="Production\PointedPlaceText.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agent\airimayor.Agent.csproj" />
    <Reference Include="Unity.Entities" HintPath="$(GameManagedPath)\Unity.Entities.dll" />
    <Reference Include="Unity.Mathematics" HintPath="$(GameManagedPath)\Unity.Mathematics.dll" />
  </ItemGroup>

</Project>
