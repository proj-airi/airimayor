{
  "name": "airimayor-repository-checks",
  "private": true,
  "scripts": {
    "postinstall": "alint plugin install",
    "lint": "node scripts/lint/check.mjs",
    "lint:ai": "alint --dirty",
    "lint:ai:all": "alint .",
    "test:lint": "node --test scripts/lint/*.test.mjs"
  },
  "devDependencies": {
    "@alint-js/cli": "0.8.0",
    "markdown-it": "15.0.3"
  }
}
